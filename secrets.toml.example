# Copie este archivo a `.streamlit/secrets.toml` (local) o péguelo en
# Streamlit Cloud → App settings → Secrets.
# Nunca confirme valores reales en git.

APP_PASSWORD = "replace-with-local-or-cloud-password"
OPENAI_API_KEY = "sk-example-not-a-real-key"
REGIONES_CSV_URL = "https://docs.google.com/spreadsheets/d/EXAMPLE_REGIONES/export?format=csv"
INTERNET_CSV_URL = "https://docs.google.com/spreadsheets/d/EXAMPLE_INTERNET/export?format=csv"

# Notificación opcional de uso (omitir o dejar vacío = no se envía correo).
# SMTP_PASSWORD debe ser una contraseña de aplicación de Gmail, no la de la cuenta.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "notify-example@gmail.com"
SMTP_PASSWORD = "xxxx-xxxx-xxxx-xxxx"
SMTP_FROM = "notify-example@gmail.com"
USAGE_NOTIFY_EMAIL = "ops-example@example.com"
